# Copier ce fichier en .env et remplacer les valeurs.
# .env n'est JAMAIS versionne (voir .gitignore) : il contient les vrais secrets.

# --- Environnement ---
# dev | test | prod. Pilote le niveau de detail des erreurs renvoyees et
# l'ouverture de la documentation Swagger.
APP_ENV=dev

# --- Base de donnees ---
DATABASE_URL=postgresql+psycopg://futurisys:futurisys@localhost:5432/futurisys

# --- Securite ---
# Cle de signature des jetons d'acces. En generer une nouvelle avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Celle-ci est un exemple : une cle publiee permettrait de fabriquer de faux jetons.
SECRET_KEY=changez-cette-cle-avant-toute-mise-en-ligne
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Compte administrateur cree au premier demarrage ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe
